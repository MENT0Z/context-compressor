{
  "manifest_version": 3,
  "name": "LLM Extractor",
  "description": "Extract LLM conversations",
  "version": "1.0",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "utils/turndown.js",
        "utils/parser.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}